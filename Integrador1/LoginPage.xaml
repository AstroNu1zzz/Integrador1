<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Integrador1.LoginPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#121212">

    <Grid Padding="35" RowDefinitions="Auto, Auto, Auto, Auto, Auto" RowSpacing="25" VerticalOptions="Center">

        <!-- Icono / Imagen (puedes cambiarlo luego) -->
        <Image Source="logo.png" HeightRequest="120" Grid.Row="0" HorizontalOptions="Center" Margin="0,0,0,20"/>

        <Label Text="Acceso Local" FontSize="32" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalOptions="Center" Grid.Row="1"/>

        <!-- Cajas de texto con estilo oscuro -->
        <Frame Grid.Row="2" BackgroundColor="#1E1E1E" BorderColor="#2C2C2C" CornerRadius="12" Padding="15,0" HasShadow="False">
            <Entry x:Name="TxtUsername" Placeholder="Usuario" PlaceholderColor="#888888" TextColor="#FFFFFF" ClearButtonVisibility="WhileEditing" />
        </Frame>

        <Frame Grid.Row="3" BackgroundColor="#1E1E1E" BorderColor="#2C2C2C" CornerRadius="12" Padding="15,0" HasShadow="False">
            <Entry x:Name="TxtPassword" Placeholder="Contraseña" IsPassword="True" PlaceholderColor="#888888" TextColor="#FFFFFF" ClearButtonVisibility="WhileEditing" />
        </Frame>

        <!-- Botones -->
        <Grid Grid.Row="4" ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,15,0,0">
            <Button Text="Ingresar" Grid.Column="0" Clicked="OnLoginClicked" BackgroundColor="#0A84FF" TextColor="#FFFFFF" CornerRadius="10" FontAttributes="Bold" HeightRequest="50"/>
            <Button Text="Crear Cuenta" Grid.Column="1" Clicked="OnRegisterClicked" BackgroundColor="Transparent" TextColor="#0A84FF" BorderColor="#0A84FF" BorderWidth="1.5" CornerRadius="10" FontAttributes="Bold" HeightRequest="50"/>
        </Grid>
    </Grid>

</ContentPage>