<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Integrador1.MainPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#121212">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20,20,20,0">

        <!-- CABECERA -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto, Auto" Margin="0,10,15,25">
            <Label Text="Mis Archivos" FontSize="28" FontAttributes="Bold" TextColor="#FFFFFF" VerticalOptions="Center"/>
            <SearchBar
x:Name="BuscarBar"
        Grid.Column="1"        
    Placeholder="Buscar Archivo"
    TextChanged="Buscar"/>

            <Button Grid.Column="2" Text="+ Subir" Clicked="OnUploadClicked" BackgroundColor="#0A84FF" TextColor="#FFFFFF" CornerRadius="12" HeightRequest="45" Padding="20,0" FontAttributes="Bold" />
        </Grid>

        <!-- LISTA DE ARCHIVOS -->
        <CollectionView x:Name="ListaArchivos" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnArchivoSeleccionado">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <!-- VisualStateManager para controlar el color al seleccionar (Quita el naranja) -->
                    <Border Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 16" Margin="0,0,0,12" Padding="15">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="#1E1E1E" />
                                        <Setter Property="Stroke" Value="#2C2C2C" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="#1A2235" />
                                        <Setter Property="Stroke" Value="#0A84FF" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                            <!-- Icono -->
                            <Image Source="{Binding IconoArchivo}" WidthRequest="40" HeightRequest="40" Aspect="AspectFit" Grid.Column="0" VerticalOptions="Center"/>

                            <!-- Nombre y Tipo -->
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                <Label Text="{Binding Nombre}" FontSize="16" FontAttributes="Bold" TextColor="#FFFFFF" LineBreakMode="TailTruncation"/>
                                <Label Text="{Binding Tipo}" FontSize="13" TextColor="#888888"/>
                            </VerticalStackLayout>

                            <!-- Botones de Acción (Descargar, Renombrar, Eliminar) -->
                            <HorizontalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="8">
                                <!-- Botón Descargar (Azul oscuro) -->
                                <ImageButton Source="descarga.png" BackgroundColor="#1E3A8A" CornerRadius="10" WidthRequest="38" HeightRequest="38" Padding="10" Clicked="OnDownloadClicked" CommandParameter="{Binding Id}"/>

                                <!-- Botón Renombrar (Naranja oscuro) -->
                                <ImageButton Source="edicion.png" BackgroundColor="#92400E" CornerRadius="10" WidthRequest="38" HeightRequest="38" Padding="10" Clicked="OnRenameClicked" CommandParameter="{Binding Id}"/>

                                <!-- Botón Eliminar (Rojo oscuro) -->
                                <ImageButton Source="eliminar.png" BackgroundColor="#3A1C1C" CornerRadius="10" WidthRequest="38" HeightRequest="38" Padding="10" Clicked="OnDeleteClicked" CommandParameter="{Binding Id}"/>
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- ZONA MULTIMEDIA -->
        <Border Grid.Row="2" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 20" BackgroundColor="#000000" Margin="0,15,0,25" HeightRequest="260" Padding="0">
            <Grid>
                <Label x:Name="LblPlaceholder" Text="Selecciona un archivo" TextColor="#555555" HorizontalOptions="Center" VerticalOptions="Center" FontSize="15" FontAttributes="Bold"/>

                <toolkit:MediaElement x:Name="ReproductorMultimedia" ShouldAutoPlay="True" ShouldShowPlaybackControls="True" IsVisible="False" Aspect="AspectFit"/>

                <Image x:Name="VisualizadorImagen" Aspect="AspectFit" IsVisible="False" Margin="10"/>

                <ScrollView x:Name="VisualizadorTexto" IsVisible="False" Margin="20">
                    <Label x:Name="LblContenidoTexto" TextColor="#E0E0E0" FontSize="14" />
                </ScrollView>
            </Grid>
        </Border>

    </Grid>
</ContentPage>